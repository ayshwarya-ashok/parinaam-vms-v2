<h1 style="margin:0 0 12px;font-size:22px;">You're registered</h1>
<p style="margin:0 0 16px;">Dear {{firstName}}, your place is confirmed for:</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;margin:0 0 16px;border:1px solid rgba(19,35,37,.10);border-radius:12px;">
  <tr><td style="padding:14px 16px;">
    <p style="margin:0;font-weight:700;font-size:16px;">{{eventName}}</p>
    <p style="margin:4px 0 0;color:#5e6a62;font-size:13px;">{{programName}} &middot; {{activityName}}</p>
    <p style="margin:8px 0 0;font-size:14px;">🗓 {{eventDate}} at {{eventTime}}<br>📍 {{location}}</p>
  </td></tr>
</table>
{{#if outstandingTrainings}}
<p style="margin:0 0 8px;font-weight:700;color:#bc5328;">Before you attend, complete:</p>
<ul style="margin:0 0 16px;padding-left:20px;">{{#each outstandingTrainings}}<li>{{this}}</li>{{/each}}</ul>
{{/if}}
<p style="margin:0;color:#5e6a62;font-size:13px;">Please arrive 10 minutes early. Contact your coordinator if anything changes.</p>
