<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{orgName}}</title>
</head>
<body style="margin:0;padding:0;background:#F4F7FA;font-family:'Segoe UI',Helvetica,Arial,sans-serif;color:#445563;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F4F7FA;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(31,43,54,0.10);">
        <tr>
          <td style="background:#1F2B36;padding:20px 28px;">
            <img src="{{webUrl}}/parinaam-logo-dark.png" alt="" height="30" style="display:block;margin:0 0 8px;" />
            <p style="margin:0;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#1E7AB2;font-weight:700;">{{orgName}}</p>
          </td>
        </tr>
        <tr><td style="padding:28px;font-size:15px;line-height:1.7;">{{{body}}}</td></tr>
        <tr>
          <td style="padding:18px 28px;background:#EDF2F7;border-top:1px solid rgba(31,43,54,.08);">
            <p style="margin:0;font-size:12px;color:#5E6E7E;">
              &copy; {{year}} {{orgName}}. This message was sent by the Parinaam Volunteer Management System.
            </p>
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
