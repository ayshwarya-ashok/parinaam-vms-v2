<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{orgName}}</title>
</head>
<body style="margin:0;padding:0;background:#f4ede2;font-family:'Segoe UI',Helvetica,Arial,sans-serif;color:#132325;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4ede2;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#fffcf7;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(19,35,37,0.10);">
        <tr>
          <td style="background:#0f2b2d;padding:20px 28px;">
            <p style="margin:0;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:#d96c3f;font-weight:700;">{{orgName}}</p>
          </td>
        </tr>
        <tr><td style="padding:28px;font-size:15px;line-height:1.7;">{{{body}}}</td></tr>
        <tr>
          <td style="padding:18px 28px;background:#f8f6f2;border-top:1px solid rgba(19,35,37,.08);">
            <p style="margin:0;font-size:12px;color:#5e6a62;">
              &copy; {{year}} {{orgName}}. This message was sent by the Parinaam Volunteer Management System.
            </p>
          </td>
        </tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
