# =============================================================================
# Parinaam VMS v2 — copy to .env and adjust. Never commit the real .env.
# =============================================================================

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=parinaam
POSTGRES_PASSWORD=parinaam_dev_pw
POSTGRES_DB=parinaam_vms
POSTGRES_PORT=5432

# n8n keeps its own state in this database on the same server.
N8N_DB_NAME=n8n

# Load database/seeds/S002__demo_data.sql on first boot. Set false for prod-like runs.
SEED_DEMO_DATA=true

# ---- Ports ------------------------------------------------------------------
API_PORT=3001
WEB_PORT=5174
REDIS_PORT=6379
ADMINER_PORT=8082
N8N_PORT=5679
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
BUILD_TARGET=development
PUBLIC_WEB_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ---- Secrets (generate per environment: openssl rand -hex 32) ---------------
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
LINK_TOKEN_SECRET=dev_link_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- n8n --------------------------------------------------------------------
# Shared HMAC secret. The API signs every webhook payload with it and verifies
# every callback against it. Must match on both sides.
VMS_WEBHOOK_SECRET=dev_n8n_shared_secret_change_me

# Encrypts stored n8n credentials. Changing it makes existing credentials
# unreadable — keep it stable per environment.
N8N_ENCRYPTION_KEY=dev_n8n_encryption_key_change_me

N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5679/
# Set false and configure real accounts for anything that is not a laptop.
N8N_USER_MANAGEMENT_DISABLED=true

# ---- Mail -------------------------------------------------------------------
# The API does NOT connect to SMTP. n8n does, using its "VMS SMTP" credential,
# which points at the mailpit container locally (host mailpit, port 1025).
MAIL_FROM_NAME=Parinaam Foundation
MAIL_FROM_EMAIL=noreply@parinaam.org

# ---- Storage ----------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25
