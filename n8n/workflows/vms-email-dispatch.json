{
  "id": "vmsEmailDispatch1",
  "name": "vms-email-dispatch",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vms-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -460,
        300
      ],
      "webhookId": "vms-email"
    },
    {
      "parameters": {
        "jsCode": "// Verify the HMAC signature the VMS API attaches, then normalise the payload.\nconst crypto = require('crypto');\nconst secret = $env.VMS_WEBHOOK_SECRET;\n\nconst item = $input.first();\nconst body = item.json.body ?? item.json;\nconst headers = item.json.headers ?? {};\nconst signature = headers['x-vms-signature'] || headers['X-VMS-Signature'];\n\nif (!secret) {\n  throw new Error('VMS_WEBHOOK_SECRET is not configured on this n8n instance');\n}\n\nconst expected = crypto\n  .createHmac('sha256', secret)\n  .update(JSON.stringify(body))\n  .digest('hex');\n\nconst provided = String(signature || '');\nconst ok =\n  provided.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(provided), Buffer.from(expected));\n\nif (!ok) {\n  throw new Error('Invalid X-VMS-Signature — refusing to send');\n}\n\nif (!body.emailLogId || !body.to || !body.subject) {\n  throw new Error('Payload must carry emailLogId, to and subject');\n}\n\nreturn [{\n  json: {\n    emailLogId: body.emailLogId,\n    templateKey: body.templateKey ?? 'unknown',\n    to: body.to,\n    subject: body.subject,\n    html: body.html ?? '',\n    text: body.text ?? '',\n    fromName: body.fromName ?? 'Parinaam Foundation',\n    fromEmail: body.fromEmail ?? 'noreply@parinaam.org',\n    attachmentUrl: body.attachmentUrl ?? null,\n    attachmentName: body.attachmentName ?? null,\n    callbackUrl: body.callbackUrl,\n    executionId: $execution.id\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-attachment",
              "leftValue": "={{ $json.attachmentUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Has Attachment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -20,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.attachmentUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "attachment"
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Fetch Attachment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        180
      ],
      "notes": "Certificates and report exports are passed as a short-lived signed URL rather than base64 in the webhook body."
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.fromName }} <{{ $json.fromEmail }}>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {
          "attachments": "attachment"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Send With Attachment",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        420,
        180
      ],
      "credentials": {
        "smtp": {
          "id": "vms-smtp",
          "name": "VMS SMTP"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.fromName }} <{{ $json.fromEmail }}>",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        420,
        400
      ],
      "credentials": {
        "smtp": {
          "id": "vms-smtp",
          "name": "VMS SMTP"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Build the success callback the VMS API expects.\nconst crypto = require('crypto');\nconst secret = $env.VMS_WEBHOOK_SECRET;\nconst src = $('Verify Signature').first().json;\n\nconst payload = {\n  emailLogId: src.emailLogId,\n  status: 'sent',\n  providerMessageId: $json.messageId ?? null,\n  n8nExecutionId: src.executionId,\n  sentAt: new Date().toISOString()\n};\n\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(JSON.stringify(payload))\n  .digest('hex');\n\nreturn [{ json: { payload, signature, callbackUrl: src.callbackUrl } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Build Success Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build the failure callback. n8n has already exhausted its own retries.\nconst crypto = require('crypto');\nconst secret = $env.VMS_WEBHOOK_SECRET;\nconst src = $('Verify Signature').first().json;\n\nconst payload = {\n  emailLogId: src.emailLogId,\n  status: 'failed',\n  errorMessage: String($json.error?.message ?? $json.error ?? 'SMTP send failed'),\n  n8nExecutionId: src.executionId,\n  failedAt: new Date().toISOString()\n};\n\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(JSON.stringify(payload))\n  .digest('hex');\n\nreturn [{ json: { payload, signature, callbackUrl: src.callbackUrl } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Build Failure Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        540
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-VMS-Signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "retry": {
            "retry": {
              "maxTries": 3,
              "waitBetweenTries": 2000
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Callback VMS API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: true, executionId: $execution.id }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Respond Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -120,
        120
      ]
    }
  ],
  "connections": {
